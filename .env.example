# Palette environment variables
# Copy this file to `.env` and fill in the values, then rebuild the app
# (react-native-config injects these at native build time).

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Backend API (optional) ---
API_URL=

# --- Scan a Painting: Google Cloud Vision (required for the scan feature) ---
# Create a key in Google Cloud Console with the Cloud Vision API enabled.
GOOGLE_VISION_API_KEY=

# --- Scan a Painting: artwork identifier selection ---
# Which identifier to use: 'vision' (default) or 'bedrock'.
ARTWORK_IDENTIFIER=vision
# Server-side Bedrock/LLM proxy endpoint for the 'bedrock' identifier.
# The app POSTs { image: <base64> } and expects { title, artist, year, confidence }.
# This MUST be a backend you control that signs Bedrock with an IAM role
# server-side. NEVER embed AWS or LLM credentials in the app bundle.
ARTWORK_ID_ENDPOINT=

# --- Museum API keys (optional; museums fall back to public/demo access) ---
EUROPEANA_API_KEY=
HARVARD_API_KEY=
PARIS_API_KEY=
SMITHSONIAN_API_KEY=
